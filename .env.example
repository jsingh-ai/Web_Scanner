# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- AI provider keys ---
# At least one is required for vision escalation. Claude is preferred; if only the
# OpenAI key is present, the tool automatically falls back to OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vision model override (optional). Leave blank to use the built-in default.
# A cheaper Claude model can be set here to reduce cost. Exact IDs are pinned in code.
# VISION_MODEL=

# --- Web server ---
# Port for the status page / API.
PORT=8080
# Interface to bind. Use the VM's internal IP in production; 127.0.0.1 for local-only.
# BIND_HOST=0.0.0.0

# --- Security ---
# Shared token required for settings mutations (add/edit/delete apps).
# Generate a long random value before production use.
WRITE_TOKEN=

# --- Scheduling (optional overrides; defaults are 07:00 and 19:00 local) ---
# MORNING_CRON=0 7 * * *
# EVENING_CRON=0 19 * * *

# --- Retention (optional) ---
# Days to keep screenshots before pruning. Verdicts are kept indefinitely.
# SCREENSHOT_RETENTION_DAYS=14
